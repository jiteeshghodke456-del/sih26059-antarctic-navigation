          <mxGeometry x="40" y="420" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="g_capability" value="&lt;b&gt;capability&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Can this ship legally and physically operate here?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_chart" value="&lt;b&gt;chart&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Is the route geographically understood well enough?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="132" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_ice" value="&lt;b&gt;ice&lt;/b&gt; — MARGINAL&lt;br&gt;&lt;font style='font-size:9px'&gt;Will expected ice exceed the ship's operating limit?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5A4708;" vertex="1" parent="1">
          <mxGeometry x="330" y="194" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_weather" value="&lt;b&gt;weather&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Will wind, waves or visibility make the corridor unsafe?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="256" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_traffic" value="&lt;b&gt;traffic&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Is there conflict with other vessels or operations?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="318" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_logistics" value="&lt;b&gt;logistics&lt;/b&gt; — PASS&lt;br&gt;&lt;font style='font-size:9px'&gt;Will this track still meet the station's operating window?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_communications" value="&lt;b&gt;communications&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Can the ship get timely warnings and coordinate?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="442" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_contingency" value="&lt;b&gt;contingency&lt;/b&gt; — PASS&lt;br&gt;&lt;font style='font-size:9px'&gt;If the route closes ahead, where do we go?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;" vertex="1" parent="1">
          <mxGeometry x="330" y="504" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g_execution" value="&lt;b&gt;execution&lt;/b&gt; — UNKNOWN&lt;br&gt;&lt;font style='font-size:9px'&gt;Are observations still consistent with what we approved?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#f0f2f4;strokeColor=#9aa7b0;fontColor=#5C666E;dashed=1;dashPattern=4 3;" vertex="1" parent="1">
          <mxGeometry x="330" y="566" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="health" value="ROUTE HEALTH&lt;br&gt;worst gate state wins&lt;br&gt;&lt;font style='font-size:10px'&gt;VALID · DEGRADED · CRITICAL · INVALID&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5C1F1D;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="250" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="digest" value="&lt;b&gt;gate_digest()&lt;/b&gt;&lt;br&gt;Identical evidence yields an identical digest, so re-evaluating raises no transition. This is what separates “an assumption changed” from “new data arrived”." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0bcc4;fontColor=#46545F;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="master" value="Master&lt;br&gt;approves?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f5d9e8;strokeColor=#b8559a;fontColor=#5C2049;" vertex="1" parent="1">
          <mxGeometry x="720" y="500" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="log" value="Decision log&lt;br&gt;versions · supersedes&lt;br&gt;who · when · why" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3B2A4A;" vertex="1" parent="1">
          <mxGeometry x="700" y="630" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="diverge" value="&lt;b&gt;Divergence&lt;/b&gt;&lt;br&gt;If the digest moves after approval, the master is told WHICH gate flipped — e.g. “logistics: PASS to FAIL”. An approved plan is never silently replaced (§4)." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0bcc4;fontColor=#46545F;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="730" width="240" height="104" as="geometry" />
        </mxCell>
        <mxCell id="key" value="&lt;b&gt;Why six gates are grey&lt;/b&gt;&lt;br&gt;A gate we cannot evaluate is NOT a pass — it caps health at DEGRADED. Reporting VALID while blind to the chart, the weather and the traffic picture is a false negative, and §48A.12 makes that the expensive error here. Grey is absence of measurement, not a hazard: colouring it red would claim we looked.&lt;br&gt;&lt;br&gt;Consequence: this prototype cannot certify any route as VALID, and says so." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fillColor=#ffffff;strokeColor=#b0bcc4;fontColor=#46545F;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="560" height="150" as="geometry" />
        </mxCell>
