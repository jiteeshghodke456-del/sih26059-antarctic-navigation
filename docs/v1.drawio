<mxfile host="app.diagrams.net" type="device">
  <diagram name="Decision workflow" id="navflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="3242" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" value="LEGEND&amp;nbsp; &amp;nbsp;solid = built and measured&amp;nbsp; &amp;#183;&amp;nbsp; dashed = designed, not built&amp;nbsp; &amp;#183;&amp;nbsp; dotted = white space, no product exists anywhere&lt;br&gt;orange = Jiteesh's original step&amp;nbsp; &amp;#183;&amp;nbsp; blue = added this pass&amp;nbsp; &amp;#183;&amp;nbsp; green = data source&amp;nbsp; &amp;#183;&amp;nbsp; grey = a gap, stated plainly&amp;nbsp; &amp;#183;&amp;nbsp; purple = external library we reuse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="62" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Start" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5C1F1D;" vertex="1" parent="1">
          <mxGeometry x="750" y="110" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="marks" value="Captain Marks Route in the Application" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="670" y="180" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="nlogin" value="Captain Logs in application" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="186" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="aIn" value="A" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="606" y="190" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="trigger2" value="NEW: new pack, observation or ship-sensor update arrives&lt;br&gt;&lt;font style='font-size:9px'&gt;the loop must also start without the captain asking &amp;#8212; an already cleared route may have closed up&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="90" y="168" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="Route is sent to the application's local processing" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="670" y="280" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="nnav" value="Navigation Decision Processing start" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1060" y="286" width="260" height="44" as="geometry" />
        </mxCell>
        <mxCell id="nlocal" value="NEW: local = the bridge laptop&lt;br&gt;&lt;font style='font-size:9px'&gt;no outbound network south of ~70&amp;#176;S. Everything below reads the voyage pack, not the internet &amp;#8212; see page 2&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="90" y="268" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chk" value="AI model checks yesterdays ice movement forecast correctness&lt;br&gt;&lt;font style='font-size:9px'&gt;yesterday's 1-day forecast vs today's observation&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f5d9e8;strokeColor=#b8559a;fontColor=#5C2049;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="660" y="380" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="keep" value="Keep default Confidence in route suggestion" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="150" y="415" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lower" value="Lower Confidence and increase number of safe routes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="1200" y="415" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rung" value="NEW: declare which rung we are running on, and show it to the captain&lt;br&gt;&lt;font style='font-size:9px'&gt;no do-overs at sea &amp;#8212; the system must say how degraded it is &lt;b&gt;before&lt;/b&gt; the advice, not after&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="630" y="550" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="nrung" value="1&amp;nbsp; corrected forecast + calibrated interval&lt;br&gt;2&amp;nbsp; raw CMEMS forecast (our model failed verification)&lt;br&gt;3&amp;nbsp; persistence from newest observation (feed lost)&lt;br&gt;4&amp;nbsp; climatology for the date (no recent observation)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="546" width="410" height="92" as="geometry" />
        </mxCell>
        <mxCell id="r1a" value="Read Latest &amp;amp; historical ice concentration map" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r1n" value="Taken by NSIDC satellite with SSMIS sensor" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="814" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="Clean unreliable data/noise in satellite image&lt;br&gt;&lt;font style='font-size:9px'&gt;isih/ice_quality.py &amp;#183; fires every single day, ~118 cells&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="500" y="720" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r1c" value="NEW: Polar Code &amp;#167;11.3.4 wants prior-year statistics&lt;br&gt;&lt;font style='font-size:9px'&gt;we hold 1,096 real daily files and use them only for training, never as climatology the captain can actually see&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="726" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r2a" value="Fetch weather model's Sea-ice forecast" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="872" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r2n" value="CMEMS Sea-ice forecast" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="966" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r2b" value="AI model corrects mistakes in the forecast&lt;br&gt;&lt;font style='font-size:9px'&gt;residual U-Net &amp;#183; corrected = clip(background + &amp;#916;, 0, 1)&lt;br&gt;zero-init head, so a broken model degrades to CMEMS, not to zero&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="500" y="872" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r2c" value="Add calibrated safety margin for vessel&lt;br&gt;&lt;font style='font-size:9px'&gt;stratified conformal &amp;#8594; SIC_upper, the number the router really uses&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="878" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r3a" value="Fetch current iceberg location near the course" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="1024" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r3n" value="USNIC Current iceberg positions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1118" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="Predict Iceberg trajectory&lt;br&gt;&lt;font style='font-size:9px'&gt;Wagner closed form &amp;#183; &lt;b&gt;physics, not machine learning&lt;/b&gt; &amp;#183; 23/23 tests pass &amp;#183; &amp;#8594; exclusion polygons&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="500" y="1024" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r3c" value="USNIC tracks bergs &amp;#8805; ~18.5 km&lt;br&gt;&lt;font style='font-size:9px'&gt;a growler is ~5 m. That gap is 3.5 orders of magnitude and nothing in orbit closes it &amp;#8212; radar and the lookout own it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="930" y="1030" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r4a" value="Fetch Environment&amp;nbsp; and Hazards lying ahead" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="1176" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r4n" value="ERA5/GFS wind + waves , GEBCO/IBCSO bathymetry" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1270" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value="Analyze weather forecast and hazards ahead&lt;br&gt;&lt;font style='font-size:9px'&gt;wind sets the ice: free drift &amp;#8776; 2% of wind speed, deflected 20&amp;#8211;40&amp;#176; &lt;b&gt;left&lt;/b&gt; in the southern hemisphere&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="500" y="1176" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r4c" value="ERA5 under-reads the winds that beset ships&lt;br&gt;&lt;font style='font-size:9px'&gt;bias &amp;#8722;3.89 m/s above 20 m/s. Bias-correct it with the ship's own anemometer, or say so out loud&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="1182" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r5a" value="NEW: Read protected and ecologically sensitive areas" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="70" y="1328" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r5n" value="CCAMLR MPAs, ASPA / ASMA, marine-mammal measures" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1422" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r5b" value="Mark them as areas the route may not cross&lt;br&gt;&lt;font style='font-size:9px'&gt;rides the same excluded_zones hook as the icebergs (ADR-010) &amp;#8212; the mechanism already exists, only the polygons are missing&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="500" y="1328" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r5c" value="Polar Code &amp;#167;11.3.6&amp;#8211;.8 requires this&lt;br&gt;&lt;font style='font-size:9px'&gt;protected areas and marine-mammal measures are mandatory planning factors. We currently consider neither&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="1334" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r6a" value="NEW: Read the ship's own sensors" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="70" y="1480" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r6n" value="shaft power, speed log, X/S-band radar, AIS, met station, helicopter ice recon" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1574" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r6b" value="Correct our own models with what the ship actually measures&lt;br&gt;&lt;font style='font-size:9px'&gt;shaft power is a &lt;b&gt;measured&lt;/b&gt; ice resistance &amp;#8212; the one number our vessel config admits is borrowed from another hull&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="500" y="1480" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r6c" value="Golovnin already flies ice reconnaissance&lt;br&gt;&lt;font style='font-size:9px'&gt;she carries two helicopters used for ice air recon on the route. That observation has no path into the system&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=2 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="1486" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r7a" value="NEW: Estimate ice pressure / compression risk" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=2 4;" vertex="1" parent="1">
          <mxGeometry x="70" y="1632" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r7n" value="modelled drift field &amp;#8594; divergence &amp;#8706;u/&amp;#8706;x + &amp;#8706;v/&amp;#8706;y" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1726" width="400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="r7b" value="Flag convergence setting into the fast-ice edge&lt;br&gt;&lt;font style='font-size:9px'&gt;the documented besetting geometry &amp;#8212; and exactly where the ship sits to offload at Bharati and Maitri&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=2 4;" vertex="1" parent="1">
          <mxGeometry x="500" y="1632" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="r7c" value="No operational Antarctic pressure product exists, anywhere&lt;br&gt;&lt;font style='font-size:9px'&gt;POLARIS never uses the words pressure, compression, ridge or drift. This is white space, not an oversight&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;dashPattern=2 4;" vertex="1" parent="1">
          <mxGeometry x="930" y="1638" width="400" height="88" as="geometry" />
        </mxCell>
        <mxCell id="cband" value="READ THE VOYAGE PACK &amp;#8212; independent streams, in parallel.&amp;nbsp;&amp;nbsp;Nothing here is optional: the router consumes all of it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="664" width="1600" height="1132" as="geometry" />
        </mxCell>
        <mxCell id="mesh" value="build vessel modelled ice mesh" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="530" y="1842" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tmesh" value="meshiphi" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3F2A50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1852" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nmesh" value="non-uniform &amp;#8212; splits hardest where the ice is most variable. Calibrated to MV Vasiliy Golovnin: beam 22.4 m, 16.4 kn" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="170" y="1836" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="router" value="Compute candidate routes" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="530" y="1942" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trouter" value="PolarRoute" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3F2A50;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1952" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ntime" value="NEW: one mesh layer per forecast day&lt;br&gt;&lt;font style='font-size:9px'&gt;today the router plans a 17-day voyage on day-0 ice, as if the field holds still. It does not&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="90" y="1934" width="400" height="76" as="geometry" />
        </mxCell>
        <mxCell id="polaris" value="Is course's POLARIS ice concentration safe&lt;br&gt;&lt;font style='font-size:9px'&gt;TODAY: a flat 80% cutoff. POLARIS is indexed by ice &lt;b&gt;type&lt;/b&gt;, so real compliance needs a thickness channel first&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f5d9e8;strokeColor=#b8559a;fontColor=#5C2049;" vertex="1" parent="1">
          <mxGeometry x="640" y="2057" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="recarto" value="Advise Captain to recartograph a new route" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="1140" y="2097" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aOut" value="A" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1287" y="2182" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="hold" value="NEW: if no candidate ever passes &amp;#8212; hold at the ice edge and wait&lt;br&gt;&lt;font style='font-size:9px'&gt;the real answer at sea, and what Aurora Australis did at Mawson in 2014. An endless redraw loop is not an outcome&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="90" y="2083" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="annot" value="NEW: attach the hazards we cannot hard-gate on&lt;br&gt;&lt;font style='font-size:9px'&gt;pressure risk &amp;#183; protected-area proximity &amp;#183; &lt;b&gt;when the lookout will be blind&lt;/b&gt;: sea state &amp;gt; 4 ft hides growlers, blizzard visibility &amp;#8804; 100 m&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="610" y="2242" width="460" height="88" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="NEW: is this the departure decision, or are we already underway?&lt;br&gt;&lt;font style='font-size:9px'&gt;the captain's own instruction: argue once, then support&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f5d9e8;strokeColor=#b8559a;fontColor=#5C2049;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="640" y="2372" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tau" value="Is new route better enough to suggest it?&lt;br&gt;&lt;font style='font-size:9px'&gt;Cost(current) &amp;#8722; Cost(alt) &amp;gt; &amp;#964;, where &amp;#964; comes from our own calibrated interval &amp;#8212; not a hand-tuned number&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;align=center;fillColor=#f5d9e8;strokeColor=#b8559a;fontColor=#5C2049;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="170" y="2562" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="draw" value="Draw recommended route and two backups for captain" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="2747" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="keeporig" value="Keep the captains original route" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="420" y="2747" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="picks" value="NEW: the captain picks. His choice becomes THE route.&lt;br&gt;&lt;font style='font-size:9px'&gt;from here we never re-argue it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="190" y="2847" width="400" height="64" as="geometry" />
        </mxCell>
        <mxCell id="micro" value="NEW: do not re-open the strategic choice. Suggest micro changes, and the things he can miss.&lt;br&gt;&lt;font style='font-size:9px'&gt;a system that keeps arguing for a route the captain already rejected is a system that gets switched off&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2587" width="420" height="96" as="geometry" />
        </mxCell>
        <mxCell id="advisory" value="NEW: write it in ice-navigator language, and show the calculation&lt;br&gt;&lt;font style='font-size:9px'&gt;&amp;quot;9/10 close pack, thick first-year, ridged&amp;quot; &amp;#8212; not &amp;quot;lots of ice&amp;quot;. WMO egg code: concentration, stage of development, floe size&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="610" y="2962" width="460" height="92" as="geometry" />
        </mxCell>
        <mxCell id="rescue" value="NEW: if trouble is foreseen &amp;#8212; nearest icebreaker, station and MRCC for this sector&lt;br&gt;&lt;font style='font-size:9px'&gt;Polar Code &amp;#167;11.3.5 and &amp;#167;11.3.9: places of refuge, and distance from SAR. Static data, zero bandwidth&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2958" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5C1F1D;" vertex="1" parent="1">
          <mxGeometry x="750" y="3102" width="180" height="40" as="geometry" />
        </mxCell>
