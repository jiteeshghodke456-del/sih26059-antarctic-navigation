<mxfile host="app.diagrams.net" type="device">
  <diagram name="Where it runs" id="tiers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="WHERE EACH STEP RUNS. The split is not ours: the Canadian Coast Guard's ice navigation manual already separates a STRATEGIC phase ashore from a TACTICAL phase on the bridge, and leaves the routing recommendation with the shore ice desk while the bridge keeps real-time deviation authority." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ashore" value="ASHORE &amp;#8212; bandwidth, archives and GPUs live here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;fillColor=#F3F7FB;strokeColor=#6c8ebf;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1600" height="470" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="NSIDC daily ice concentration" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="CMEMS sea-ice forecast" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="USNIC iceberg positions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="ERA5 / GFS wind and waves" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="850" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="ASPA / ASMA protected areas&lt;br&gt;(static, ships once)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="IBCSO / GEBCO bathymetry&lt;br&gt;(static, ships once)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="165" width="245" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Quality control&lt;br&gt;isih/ice_quality.py" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="290" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Train the U-Net&lt;br&gt;(GPU &amp;#8212; never at sea)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="390" y="270" width="290" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Inference + conformal&lt;br&gt;&amp;#8594; SIC_upper" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="710" y="270" width="290" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Build the vessel mesh&lt;br&gt;meshiphi" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="1030" y="270" width="290" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Fulfil imagery requests&lt;br&gt;from the ship" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="1350" y="270" width="265" height="64" as="geometry" />
        </mxCell>
        <mxCell id="wts" value="Model weights ~60 MB&lt;br&gt;&lt;font style='font-size:9px'&gt;never over the satellite link &amp;#8212; USB stick at port&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pack" value="Build and sign the voyage pack" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="540" y="390" width="520" height="64" as="geometry" />
        </mxCell>
        <mxCell id="nharvest" value="the CMEMS harvest already runs daily on GitHub Actions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="392" width="505" height="60" as="geometry" />
        </mxCell>
        <mxCell id="link" value="ACROSS THE LINK &amp;#8212; Iridium-class, ~704 kbps at best and usually far less. No geostationary VSAT reaches south of ~70&amp;#176;S." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;fillColor=#FFF6E8;strokeColor=#d79b00;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="1600" height="210" as="geometry" />
        </mxCell>
        <mxCell id="down" value="&amp;#8595;&amp;nbsp; DOWN to the ship&lt;br&gt;&lt;font style='font-size:9px'&gt;vessel-modelled mesh block &lt;b&gt;76 KB gzipped (measured)&lt;/b&gt; &amp;#183; daily delta target 50 KB &amp;#183; full corridor refresh 0.5&amp;#8211;1 MB (extrapolated)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="up" value="&amp;#8593;&amp;nbsp; UP from the ship&lt;br&gt;&lt;font style='font-size:9px'&gt;route polyline &lt;b&gt;796 B&lt;/b&gt; &amp;#183; a request for tactical imagery is a few bytes &amp;#8212; the &lt;i&gt;image&lt;/i&gt; is what we cannot afford&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="never" value="&amp;#10007;&amp;nbsp; NEVER crosses&lt;br&gt;&lt;font style='font-size:9px'&gt;60 MB model weights &amp;#183; raw NetCDF &amp;#183; any live API call. If a feature needs the internet at 70&amp;#176;S, it is not a feature&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1130" y="680" width="485" height="88" as="geometry" />
        </mxCell>
        <mxCell id="aboard" value="ABOARD &amp;#8212; everything that has to answer a question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B0B8C4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#7C8698;fontStyle=1;fillColor=#F4FAF4;strokeColor=#82b366;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1600" height="330" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="The voyage pack, on disk" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="90" y="915" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="The ship's own sensors&lt;br&gt;&lt;font style='font-size:9px'&gt;radar, AIS, shaft power, met, helicopter recon&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#13385C;" vertex="1" parent="1">
          <mxGeometry x="450" y="915" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="PolarRoute &amp;#8212; routes are computed here, locally" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="830" y="915" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="so the master can re-plan with no link at all" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#254A20;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="918" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="The decision flow in v1.drawio" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#5A3B08;" vertex="1" parent="1">
          <mxGeometry x="380" y="1020" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="The Captain decides" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5C1F1D;" vertex="1" parent="1">
          <mxGeometry x="850" y="1020" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="why not send finished routes only?&lt;br&gt;&lt;font style='font-size:9px'&gt;because then the master cannot re-plan when the ice disagrees with the forecast &amp;#8212; and it will&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="90" y="1105" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="why not run ingestion aboard?&lt;br&gt;&lt;font style='font-size:9px'&gt;GB-scale downloads and a GPU. Neither exists at 70&amp;#176;S&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="650" y="1105" width="520" height="70" as="geometry" />
        </mxCell>
